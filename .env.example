# Copy this file to .env and fill in real values.
# Never commit .env.

# Zetaris (Data layer)
ZETARIS_REST_URL=https://your-zetaris-host
ZETARIS_ORG_ID=your-org-id
ZETARIS_API_KEY=your-zetaris-api-key
# Optional overrides for scripts/load_to_zetaris.py
# ZETARIS_DATABASE=german_credit_db
# ZETARIS_TABLE_NAME=german_credit
# ZETARIS_LOCAL_STORAGE_ROOT=/home/zetaris/customer-data/shared
# ZETARIS_EXPORT_PATH=/home/zetaris/customer-data/shared/german_credit_db_german_credit
# ZETARIS_BASE_URL=http://localhost:3000

# Nightshift / Meterless (Power layer, OpenAI-compatible)
MODEL_BASE_URL=https://your-nightshift-endpoint/v1
MODEL_API_KEY=your-model-api-key
NEMOTRON_MODEL=meterless/auto
